{
  "manifest_version": 3,
  "name": "Gmail Auto CC",
  "version": "1.0.0",
  "description": "Gmailでメール作成・返信時に指定したアドレスを自動でCCに追加します",
  "homepage_url": "https://github.com/akirita/chrome-extension-gmail-auto-cc",
  "permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Gmail Auto CC 設定"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
